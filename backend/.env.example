PORT=3000
JWT_SECRET=petfind-dev-secret-change-me
JWT_EXPIRES_IN=7d
DEFAULT_NOTIFICATION_RADIUS_KM=5

# PostgreSQL — use DATABASE_URL (nuvem, ex.: Supabase) ou as variáveis DB_* abaixo (Postgres local).
# Supabase: botão "Connect" do projeto > Session pooler (porta 5432 no host *.pooler.supabase.com).
# Evite a "Direct connection": no plano gratuito ela é só IPv6 e falha em muitas redes.
# Se a senha tiver caracteres especiais (@ : / # ?), troque-os por %40 %3A %2F %23 %3F na URL.
# DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petfind
DB_USER=postgres
DB_PASSWORD=

# Fotos no Supabase Storage (obrigatório em hospedagem serverless, ex.: Vercel).
# Crie um bucket PÚBLICO chamado "fotos" (Storage > New bucket) e use a chave
# service_role (Project Settings > API). Nunca exponha essa chave no app nem no git.
# Sem estas duas variáveis, as fotos são gravadas em backend/uploads (modo local).
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=fotos

# E-mail de recuperação de senha (RF-003) via SMTP. Exemplo com Gmail:
# ative a verificação em duas etapas e crie uma "senha de app" em
# myaccount.google.com > Segurança > Senhas de app (16 caracteres, sem espaços).
# Sem SMTP_USER/SMTP_PASS o código aparece só no console e em devCode (modo teste).
# SMTP_USER=seu.email@gmail.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=PetFind <seu.email@gmail.com>
